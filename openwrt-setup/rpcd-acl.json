{
	"openwalla": {
		"description": "ACL permissions for openwalla OpenWrt interface",
		"read": {
			"file": {
				"/lib/apk/db/installed": ["read"],
				"/usr/lib/opkg/status": ["read"],
				"/var/lib/opkg/status": ["read"],
				"/proc/net/dev": ["read"],
				"/proc/net/arp": ["read"],
				"/proc/stat": ["read"],
				"/proc/sys/net/netfilter/nf_conntrack_count": ["read"],
				"/proc/sys/net/netfilter/nf_conntrack_max": ["read"],
				"/etc/crontabs/root": ["read"],
				"/etc/dropbear/authorized_keys": ["read"],
				"/etc/hosts": ["read"],
				"/etc/banip/banip.feeds": ["read"],
				"/etc/banip/banip.custom.feeds": ["read"],
				"/etc/banip/banip.countries": ["read"],
				"/tmp/openwalla-ping-monitor.txt": ["read"],
				"/tmp/openwalla-dns-monitor.txt": ["read"],
				"/tmp/openwalla-speedtest-monitor.txt": ["read"],
				"/tmp/openwalla-netify.sqlite": ["read"],
				"/tmp/openwalla-connection-flows.sqlite": ["read"],
				"/tmp/openwalla-devices.sqlite": ["read"],
				"/tmp/openwalla-device-bandwidth.sqlite": ["read"],
				"/tmp/openwalla-notifications.sqlite": ["read"],
				"/tmp/openwalla-parental.sqlite": ["read"],
				"/tmp/firmware.bin": ["read"],
				"/tmp/backup.tar.gz": ["read"]
			},
			"ubus": {
				"network.interface": ["dump"],
				"network.wireless": ["status"],
				"uci": ["get"],
				"file": ["read"],
				"system": ["info", "board"],
				"luci-rpc": ["getDHCPLeases", "getNetworkDevices", "getWirelessDevices"],
				"service": ["list"]
			},
			"uci": ["openwalla", "banip", "sqm", "qos", "wireless", "dhcp", "network", "adblock", "pbr"]
		},
		"write": {
			"file": {
				"/bin/sh": ["exec"],
				"/bin/cat": ["exec"],
				"/bin/df": ["exec"],
				"/bin/grep": ["exec"],
				"/bin/mv": ["exec"],
				"/bin/rm": ["exec"],
				"/bin/tail": ["exec"],
				"/usr/bin/tail": ["exec"],
				"/sbin/uci": ["exec"],
				"/bin/uci": ["exec"],
				"/bin/vnstat": ["exec"],
				"/etc/init.d/openwalla-netify-collector": ["exec"],
				"/etc/init.d/openwalla-connection-flows-collector": ["exec"],
				"/etc/init.d/openwalla-devices-collector": ["exec"],
				"/etc/init.d/openwalla-device-bandwidth-collector": ["exec"],
				"/etc/init.d/openwalla-network-monitor": ["exec"],
				"/etc/init.d/openwalla-dns-monitor": ["exec"],
				"/etc/init.d/openwalla-state-sync": ["exec"],
				"/etc/init.d/dnsmasq": ["exec"],
				"/etc/init.d/adblock": ["exec"],
				"/etc/init.d/banip": ["exec"],
				"/etc/init.d/qos": ["exec"],
				"/etc/init.d/pbr": ["exec"],
				"/etc/init.d/cron": ["exec"],
				"/etc/init.d/sqm": ["exec"],
				"/etc/init.d/firewall": ["exec"],
				"/etc/init.d/tailscale": ["exec"],
				"/usr/bin/openwalla-tailscale": ["exec"],
				"/usr/bin/openwalla-netify-collector": ["exec"],
				"/usr/bin/openwalla-connection-flow-collector": ["exec"],
				"/usr/bin/openwalla-devices-collector": ["exec"],
				"/usr/bin/openwalla-device-bandwidth-collector": ["exec"],
				"/usr/bin/openwalla-network-monitor": ["exec"],
				"/usr/bin/openwalla-dns-monitor": ["exec"],
				"/usr/bin/openwalla-speedtest-monitor": ["exec"],
				"/usr/bin/openwalla-notifications-db": ["exec"],
				"/usr/bin/openwalla-state-sync": ["exec"],
				"/usr/bin/openwalla-scheduler": ["exec"],
				"/usr/bin/openwalla-parental": ["exec"],
				"/usr/bin/openwalla-device-traffic-summary": ["exec"],
				"/usr/bin/df": ["exec"],
				"/usr/bin/vnstat": ["exec"],
				"/usr/sbin/vnstat": ["exec"],
				"/usr/bin/sqlite3": ["exec"],
				"/usr/bin/sqlite3-cli": ["exec"],
				"/etc/crontabs/root": ["write"],
				"/tmp/openwalla-netify.sqlite": ["write"],
				"/tmp/openwalla-connection-flows.sqlite": ["write"],
				"/tmp/openwalla-devices.sqlite": ["write"],
				"/tmp/openwalla-device-bandwidth.sqlite": ["write"],
				"/tmp/openwalla-notifications.sqlite": ["write"],
				"/tmp/openwalla-parental.sqlite": ["write"],
				"/tmp/openwalla-ping-monitor.txt": ["write"],
				"/tmp/openwalla-dns-monitor.txt": ["write"],
				"/tmp/openwalla-speedtest-monitor.txt": ["write"]
			},
			"ubus": {
				"uci": ["set", "add", "delete", "commit"],
				"file": ["write", "exec"],
				"system": ["exec", "reboot"],
				"network.interface": ["up", "down"]
			},
			"uci": [
				"network",
				"wireless",
				"firewall",
				"dhcp",
				"system",
				"qos",
				"sqm",
				"ddns",
				"banip",
				"adblock",
				"pbr",
				"openwalla"
			]
		}
	}
}
