config ui 'features'
	option dashboard '1'
	option devices '1'
	option network '1'
	option traffic_history '1'
	option monitoring '1'
	option flows '1'
	option netify '0'
	option show_lan_ip '0'
	option colorful_graphs '0'
	option wireless '1'
	option firewall '1'
	option dhcp '1'
	option dns '1'
	option banip '1'
	option adblock '1'
	option pbr '1'
	option wireguard '1'
	option qos '1'
	option sqm '1'
	option qosify '1'
	option ddns '1'
	option diagnostics '1'
	option quarantine '1'
	option scheduler '1'
	option system '1'
	option backup '1'
	option packages '1'
	option services '1'
	option ssh_keys '1'
	option storage '1'
	option leds '0'
	option firmware '0'

config ui 'presets'
	option description 'Presets for common configurations'

config preset 'full_router'
	option name 'Full Router'
	option description 'All features enabled (default)'

config preset 'ap_switch'
	option name 'AP/Switch (Layer 2)'
	option description 'Disable L3 features: firewall, dhcp, qos, qosify, wireguard, ddns'
	option firewall '0'
	option dhcp '0'
	option qos '0'
	option sqm '0'
	option qosify '0'
	option wireguard '0'
	option ddns '0'
	option dns '0'
	option banip '0'
	option adblock '0'
	option pbr '0'
	option quarantine '0'

config preset 'minimal'
	option name 'Minimal'
	option description 'Dashboard and system settings only'
	option devices '0'
	option network '0'
	option traffic_history '0'
	option monitoring '0'
	option netify '0'
	option wireless '0'
	option firewall '0'
	option dhcp '0'
	option dns '0'
	option banip '0'
	option adblock '0'
	option pbr '0'
	option wireguard '0'
	option qos '0'
	option sqm '0'
	option qosify '0'
	option ddns '0'
	option diagnostics '0'
	option quarantine '0'
	option scheduler '0'
	option backup '0'
	option packages '0'
	option services '0'
	option ssh_keys '0'
	option storage '0'
	option leds '0'
	option firmware '0'

config netify 'collector'
	option enabled '0'
	option host '127.0.0.1'
	option port '7150'
	option db_path '/tmp/openwalla-netify.sqlite'
	option retention_rows '500000'
	option retention_hours '24'
	option stream_timeout '45'
	option exclude_protocols 'MDNS,DNS,QUIC,DHCPv6,ICMP'
	option ignore_wan_source '1'

config flow_stats 'flow_stats'
	option enabled '0'
	option db_path '/tmp/openwalla-netify-flow-stats.sqlite'
	option poll '5'
	option bucket_seconds '300'
	option retention_seconds '2592000'

config connection_flows 'connection_flows'
	option enabled '1'
	option db_path '/tmp/openwalla-connection-flows.sqlite'
	option poll_seconds '15'
	option retention_rows '50000'
	option exclude_endpoints '127.0.0.1'
	option ignore_ipv6 '1'
	option lan_to_wan_only '0'

config device_bandwidth 'device_bandwidth'
	option enabled '1'
	option db_path '/tmp/openwalla-device-bandwidth.sqlite'
	option poll_seconds '60'
	option bucket_seconds '900'
	option retention_seconds '86400'

config devices 'devices'
	option enabled '1'
	option db_path '/tmp/openwalla-devices.sqlite'
	option poll_seconds '15'
	option offline_after_seconds '90'

config parental 'parental'
	option db_path '/tmp/openwalla-parental.sqlite'

config ping 'ping_monitor'
	option enabled '1'
	option target '1.1.1.1'
	option interval '60'
	option threshold '100'
	option warning_percent '95'
	option timeout '2'
	option output_file '/tmp/openwalla-ping-monitor.txt'
	option max_lines '2000'
	option state_file '/tmp/openwalla-network-monitor.state'
	option outage_failures '2'
	option restore_successes '2'
	option alert_cooldown '1800'
	option interface_state_file '/tmp/openwalla-interface-monitor.state'

config dns 'dns_monitor'
	option enabled '1'
	option target 'openwrt.org'
	option interval '60'
	option threshold '1000'
	option timeout '3'
	option output_file '/tmp/openwalla-dns-monitor.txt'
	option max_lines '2000'

config speedtest 'speedtest_monitor'
	option enabled '1'
	option run_date ''
	option run_hour '3'
	option run_minute '15'
	option bin '/usr/bin/speedtest'
	option output_file '/tmp/openwalla-speedtest-monitor.txt'
	option max_lines '365'

config traffic 'dashboard'
	option provider 'auto'
	option window_seconds '900'
	option vnstat_interface 'br-lan'
	option monthly_limit_gb '100'
	option month_start_day '1'

config state_backup 'state_backup'
	option backup_time '720'
	option state_dir '/overlay/openwalla-state'

config quarantine 'quarantine'
	option enabled '0'
	option interval '15'
	option leases_file '/tmp/dhcp.leases'
	option state_file '/tmp/openwalla-quarantine-known.txt'
	option rule_prefix 'openwalla_quarantine_'

config adblock_report 'adblock_report'
	option max_top '10'
	option max_results '50'

config notifications 'notifications'
	option db_path '/tmp/openwalla-notifications.sqlite'

config tailscale 'tailscale'
	option advertise_lan '0'
	option lan_subnet ''
	option accept_routes '0'
	option advertise_exit_node '0'
