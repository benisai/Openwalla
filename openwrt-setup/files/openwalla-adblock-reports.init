#!/bin/sh /etc/rc.common
START=96
STOP=9
USE_PROCD=1

start_service() {
	[ "$(uci -q get openwalla.adblock_reports.enabled)" = 1 ] || return 0
	[ "$(uci -q get adblock.global.adb_enabled)" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/openwalla-adblock-reports run
	procd_set_param nice 10
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger openwalla adblock dhcp
}
